<mxfile host="app.diagrams.net">
  <diagram name="ERD Laundry">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1"
      connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600"
      pageHeight="1200" math="0" shadow="0">
      <root>

        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- PELANGGAN -->
        <mxCell id="pelanggan"
          value="PELANGGANS&#10;--------------------&#10;PK id_pelanggan&#10;nama_pelanggan&#10;no_hp&#10;alamat&#10;created_at"
          style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#dae8fc;"
          vertex="1" parent="1">
          <mxGeometry x="650" y="50" width="220" height="170" as="geometry"/>
        </mxCell>

        <!-- USERS -->
        <mxCell id="users"
          value="USERS&#10;--------------------&#10;PK id_user&#10;nama_user&#10;username&#10;password&#10;role"
          style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#dae8fc;"
          vertex="1" parent="1">
          <mxGeometry x="1050" y="50" width="220" height="180" as="geometry"/>
        </mxCell>

        <!-- LAYANAN -->
        <mxCell id="layanan"
          value="LAYANANS&#10;--------------------&#10;PK id_layanan&#10;nama_layanan&#10;harga_per_kg&#10;keterangan"
          style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#d5e8d4;"
          vertex="1" parent="1">
          <mxGeometry x="250" y="300" width="220" height="170" as="geometry"/>
        </mxCell>

        <!-- BOOKING -->
        <mxCell id="booking"
          value="BOOKINGS&#10;--------------------&#10;PK id_booking&#10;FK id_pelanggan&#10;FK id_layanan&#10;tanggal_booking&#10;waktu_booking&#10;status"
          style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#fff2cc;"
          vertex="1" parent="1">
          <mxGeometry x="50" y="50" width="240" height="220" as="geometry"/>
        </mxCell>

        <!-- TRANSAKSI -->
        <mxCell id="transaksi"
          value="TRANSAKSIS&#10;--------------------&#10;PK id_transaksi&#10;FK id_pelanggan&#10;FK id_user&#10;FK id_booking&#10;tanggal_masuk&#10;tanggal_selesai&#10;total_berat&#10;total_harga&#10;status"
          style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#f8cecc;"
          vertex="1" parent="1">
          <mxGeometry x="500" y="280" width="260" height="260" as="geometry"/>
        </mxCell>

        <!-- DETAIL -->
        <mxCell id="detail"
          value="DETAIL_TRANSAKSI&#10;--------------------&#10;PK id_detail&#10;FK id_transaksi&#10;FK id_layanan&#10;berat&#10;subtotal"
          style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#f5f5f5;"
          vertex="1" parent="1">
          <mxGeometry x="250" y="50" width="220" height="180" as="geometry"/>
        </mxCell>

        <!-- PEMBAYARAN -->
        <mxCell id="pembayaran"
          value="PEMBAYARANS&#10;--------------------&#10;PK id_pembayaran&#10;FK id_transaksi&#10;tanggal_bayar&#10;metode_bayar&#10;jumlah_bayar&#10;status_bayar"
          style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#ffe6cc;"
          vertex="1" parent="1">
          <mxGeometry x="850" y="280" width="250" height="220" as="geometry"/>
        </mxCell>

        <!-- PENGEMBALIAN -->
        <mxCell id="pengembalian"
          value="PENGEMBALIANS&#10;--------------------&#10;PK id_pengembalian&#10;FK id_transaksi&#10;tanggal_pengembalian&#10;status_pengembalian&#10;catatan"
          style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#e1d5e7;"
          vertex="1" parent="1">
          <mxGeometry x="850" y="580" width="260" height="220" as="geometry"/>
        </mxCell>

        <!-- STOK BARANG -->
        <mxCell id="stok"
          value="STOK_BARANGS&#10;--------------------&#10;PK id_barang&#10;nama_barang&#10;satuan&#10;stok&#10;minimum_stok"
          style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#d5e8d4;"
          vertex="1" parent="1">
          <mxGeometry x="50" y="520" width="240" height="180" as="geometry"/>
        </mxCell>

        <!-- RELASI -->
        <mxCell id="r1" edge="1" parent="1" source="pelanggan" target="booking">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="r2" edge="1" parent="1" source="layanan" target="booking">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="r3" edge="1" parent="1" source="booking" target="transaksi">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="r4" edge="1" parent="1" source="users" target="transaksi">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="r5" edge="1" parent="1" source="pelanggan" target="transaksi">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="r6" edge="1" parent="1" source="transaksi" target="detail">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="r7" edge="1" parent="1" source="layanan" target="detail">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="r8" edge="1" parent="1" source="transaksi" target="pembayaran">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="r9" edge="1" parent="1" source="transaksi" target="pengembalian">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>