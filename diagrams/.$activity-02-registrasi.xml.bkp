<mxfile host="Electron" version="29.3.6">
  <diagram id="activity_registrasi" name="Activity Diagram Registrasi">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" page="1" pageWidth="850" pageHeight="1100">
      <root>
